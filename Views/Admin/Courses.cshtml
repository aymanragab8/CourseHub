@model IEnumerable<CourseHub.Models.Course>

@{
    ViewData["Title"] = "Manage Courses";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                Manage Courses
            </h1>

            <p class="text-muted mb-0">
                View and manage all courses on CourseHub.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-controller="Courses"
               asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-plus-circle me-1"></i>
                Create Course

            </a>

            <a asp-controller="Admin"
               asp-action="Dashboard"
               class="btn btn-outline-secondary">

                ← Dashboard

            </a>

        </div>

    </div>


    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No courses found.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-hover align-middle shadow-sm">

                <thead class="table-light">

                    <tr>

                        <th>Image</th>

                        <th>Course</th>

                        <th>Category</th>

                        <th>Instructor</th>

                        <th>Price</th>

                        <th>Created At</th>

                        <th>Action</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var course in Model)
                    {
                        var imageUrl =
                            string.IsNullOrEmpty(course.ImageUrl)
                            ? "/images/courses/default-course.jpg"
                            : course.ImageUrl;

                        <tr>

                            <td>

                                <img src="@imageUrl"
                                     alt="@course.Title"
                                     style="
                                width:80px;
                                height:55px;
                                object-fit:cover;
                                border-radius:6px;
                                " />

                            </td>

                            <td>
                                <strong>
                                    @course.Title
                                </strong>
                            </td>

                            <td>

                                <span class="badge bg-primary">
                                    @course.Category?.Name
                                </span>

                            </td>

                            <td>
                                @course.Instructor?.FullName
                            </td>

                            <td>
                                $@course.Price.ToString("0.00")
                            </td>

                            <td>
                                @course.CreatedAt.ToString("MMM dd, yyyy")
                            </td>

                            <td>

                                <div class="d-flex gap-2">

                                    <a asp-controller="Courses"
                                       asp-action="Details"
                                       asp-route-id="@course.Id"
                                       class="btn btn-sm btn-outline-primary">

                                        View

                                    </a>

                                    <a asp-controller="Courses"
                                       asp-action="Edit"
                                       asp-route-id="@course.Id"
                                       class="btn btn-sm btn-outline-warning">

                                        Edit

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>