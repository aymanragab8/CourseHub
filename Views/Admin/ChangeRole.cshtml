@model CourseHub.ViewModels.ChangeUserRoleViewModel

@{
    ViewData["Title"] = "Change User Role";
}

<div class="row justify-content-center py-5">

    <div class="col-md-6">

        <div class="coursehub-content-card">

            <div class="card-body p-4">

                <h3 class="coursehub-admin-title mb-4">
                    Change User Role
                </h3>

                <div class="mb-3">

                    <label class="form-label">User</label>
                    <input class="form-control" value="@Model.UserName" disabled />

                </div>

                <form asp-action="ChangeRole" method="post">

                    <input asp-for="UserId" type="hidden" />

                    <div class="mb-4">

                        <label asp-for="SelectedRole" class="form-label">Role</label>
                        <select asp-for="SelectedRole" asp-items="Model.Roles" class="form-select"></select>

                    </div>

                    <button type="submit" class="btn btn-primary">Save Role</button>
                    <a asp-action="Users" class="btn btn-secondary">Cancel</a>

                </form>

            </div>

        </div>

    </div>

</div>