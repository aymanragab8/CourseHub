@model CourseHub.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-5">

    <div class="mb-5">

        <h1 class="fw-bold">
            Admin Dashboard
        </h1>

        <p class="text-muted">
            Manage CourseHub users, courses and enrollments.
        </p>

    </div>


    <div class="row g-4">


        <!-- Total Users -->

        <div class="col-md-6 col-lg-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-2">
                                Total Users
                            </p>

                            <h2 class="fw-bold">
                                @Model.TotalUsers
                            </h2>

                        </div>

                        <i class="bi bi-people fs-1 text-primary"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- Students -->

        <div class="col-md-6 col-lg-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-2">
                                Students
                            </p>

                            <h2 class="fw-bold">
                                @Model.TotalStudents
                            </h2>

                        </div>

                        <i class="bi bi-mortarboard fs-1 text-success"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- Instructors -->

        <div class="col-md-6 col-lg-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-2">
                                Instructors
                            </p>

                            <h2 class="fw-bold">
                                @Model.TotalInstructors
                            </h2>

                        </div>

                        <i class="bi bi-person-workspace fs-1 text-info"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- Courses -->

        <div class="col-md-6 col-lg-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-2">
                                Courses
                            </p>

                            <h2 class="fw-bold">
                                @Model.TotalCourses
                            </h2>

                        </div>

                        <i class="bi bi-book fs-1 text-warning"></i>

                    </div>

                </div>

            </div>

        </div>


    </div>


    <!-- Management -->

    <div class="row g-4 mt-4">


        <!-- Students -->

        <div class="col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <i class="bi bi-people fs-1 text-primary"></i>

                    <h4 class="fw-bold mt-3">
                        Students
                    </h4>

                    <p class="text-muted">
                        View and manage all registered students.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="Students"
                       class="btn btn-primary">

                        <i class="bi bi-people me-1"></i>
                        View Students

                    </a>

                </div>

            </div>

        </div>


        <!-- Instructors -->

        <div class="col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <i class="bi bi-person-workspace fs-1 text-success"></i>

                    <h4 class="fw-bold mt-3">
                        Instructors
                    </h4>

                    <p class="text-muted">
                        View all registered instructors.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="Instructors"
                       class="btn btn-success">

                        <i class="bi bi-person-workspace me-1"></i>
                        View Instructors

                    </a>

                </div>

            </div>

        </div>


        <!-- Courses -->

        <div class="col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <i class="bi bi-book fs-1 text-primary"></i>

                    <h4 class="fw-bold mt-3">
                        Courses
                    </h4>

                    <p class="text-muted">
                        View and manage all courses.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="Courses"
                       class="btn btn-primary">

                        <i class="bi bi-book me-1"></i>
                        Manage Courses

                    </a>

                </div>

            </div>

        </div>


        <!-- Enrollments -->

        <div class="col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <i class="bi bi-person-check fs-1 text-warning"></i>

                    <h4 class="fw-bold mt-3">
                        Enrollments
                    </h4>

                    <p class="text-muted">
                        View and manage all student enrollments.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="Enrollments"
                       class="btn btn-warning">

                        <i class="bi bi-person-check me-1"></i>
                        View Enrollments

                    </a>

                </div>

            </div>

        </div>


    </div>

</div>