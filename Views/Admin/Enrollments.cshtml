@model IEnumerable<CourseHub.Models.Enrollment>

@{
    ViewData["Title"] = "Manage Enrollments";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1 class="fw-bold">
                Manage Enrollments
            </h1>

            <p class="text-muted mb-0">
                View and manage all student enrollments.
            </p>

        </div>

        <a asp-action="Dashboard"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Dashboard

        </a>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm">

            <div class="card-body text-center p-5">

                <i class="bi bi-person-check fs-1 text-muted"></i>

                <h3 class="mt-3">
                    No Enrollments
                </h3>

                <p class="text-muted">
                    There are no student enrollments yet.
                </p>

            </div>

        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>
                                Student
                            </th>

                            <th>
                                Email
                            </th>

                            <th>
                                Course
                            </th>

                            <th>
                                Enrolled At
                            </th>

                            <th>
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var enrollment in Model)
                        {
                            <tr>

                                <td>

                                    <strong>
                                        @enrollment.Student.FullName
                                    </strong>

                                </td>


                                <td>
                                    @enrollment.Student.Email
                                </td>


                                <td>
                                    @enrollment.Course.Title
                                </td>


                                <td>
                                    @enrollment.EnrolledAt.ToString("MMM dd, yyyy HH:mm")
                                </td>


                                <td>

                                    <form asp-action="DeleteEnrollment"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to remove this enrollment?');">

                                        <input type="hidden"
                                               name="id"
                                               value="@enrollment.Id" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">

                                            <i class="bi bi-trash me-1"></i>
                                            Remove

                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>