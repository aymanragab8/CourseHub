@{
    int statusCode = ViewBag.StatusCode ?? 500;

    ViewData["Title"] = statusCode == 404
        ? "Page Not Found"
        : "Error";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-8 col-lg-6">

            <div class="card border-0 shadow-sm text-center">

                <div class="card-body p-5">

                    @if (statusCode == 404)
                    {
                        <i class="bi bi-search text-warning"
                           style="font-size: 5rem;"></i>

                        <h1 class="fw-bold mt-4">
                            Page Not Found
                        </h1>

                        <p class="text-muted fs-5 mt-3">
                            The page you are looking for doesn't exist.
                        </p>
                    }
                    else if (statusCode == 403)
                    {
                        <i class="bi bi-shield-lock text-danger"
                           style="font-size: 5rem;"></i>

                        <h1 class="fw-bold mt-4">
                            Access Denied
                        </h1>

                        <p class="text-muted fs-5 mt-3">
                            You don't have permission to access this page.
                        </p>
                    }
                    else
                    {
                        <i class="bi bi-exclamation-circle text-danger"
                           style="font-size: 5rem;"></i>

                        <h1 class="fw-bold mt-4">
                            Error @statusCode
                        </h1>

                        <p class="text-muted fs-5 mt-3">
                            Something went wrong.
                        </p>
                    }

                    <div class="mt-4">

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-primary">

                            <i class="bi bi-house me-1"></i>
                            Back to Home

                        </a>

                        <button onclick="history.back()"
                                class="btn btn-outline-secondary ms-2">

                            <i class="bi bi-arrow-left me-1"></i>
                            Go Back

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>