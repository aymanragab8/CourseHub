@model CourseHub.ViewModels.CourseDetailsViewModel

@{
    ViewData["Title"] = Model.Title;

    bool enrollmentClosed =
        Model.EnrollmentDeadline <= DateTime.Now;

    string imageUrl =
        string.IsNullOrEmpty(Model.ImageUrl)
            ? "/images/courses/default-course.jpg"
            : Model.ImageUrl;
}

<div class="container py-5">

    <div class="row g-4">

        <!-- ========================= -->
        <!-- Course Image -->
        <!-- ========================= -->

        <div class="col-md-5">

            <div class="coursehub-content-card">

                <img src="@imageUrl"
                     class="img-fluid rounded"
                     alt="@Model.Title"
                     style="
                width: 100%;
                height: 350px;
                object-fit: cover;
                " />

            </div>

        </div>


        <!-- ========================= -->
        <!-- Course Information -->
        <!-- ========================= -->

        <div class="col-md-7">

            <!-- Category -->

            <span class="badge bg-primary mb-2">
                @Model.CategoryName
            </span>


            <!-- Title -->

            <h1 class="coursehub-admin-title">
                @Model.Title
            </h1>


            <!-- Instructor -->

            <p class="text-muted mb-4">
                By @Model.InstructorName
            </p>


            <!-- Description -->

            <p class="mt-3">
                @Model.Description
            </p>


            <!-- Price -->

            <h3 class="course-price mt-4">
                $@Model.Price
            </h3>


            <!-- ========================= -->
            <!-- Enrollment Deadline -->
            <!-- ========================= -->

            <div class="mt-4">

                <strong>
                    Enrollment Deadline:
                </strong>

                <span class="@(enrollmentClosed
                                                                        ? "text-danger"
                                                                        : "text-success")">

                    @Model.EnrollmentDeadline.ToString(
                        "MMM dd, yyyy HH:mm")

                </span>

            </div>


            <!-- ========================= -->
            <!-- Student Actions -->
            <!-- ========================= -->
            @if (User.IsInRole("Student"))
            {
                <div class="mt-4">

                    @if (Model.IsEnrolled)
                    {
                        <!-- Already Enrolled -->

                        <div class="alert alert-success">
                            You are enrolled in this course.
                        </div>

                        <form asp-controller="Enrollment"
                              asp-action="Unenroll"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="courseId"
                                   value="@Model.Id" />

                            <button type="submit"
                                    class="btn btn-outline-danger">

                                Unenroll

                            </button>

                        </form>
                    }
                    else if (enrollmentClosed)
                    {
                        <!-- Enrollment Closed -->

                        <div class="alert alert-danger">
                            Enrollment is closed for this course.
                        </div>

                        <button type="button"
                                class="btn btn-secondary"
                                disabled>

                            Enrollment Closed

                        </button>
                    }
                    else
                    {
                        <!-- Can Enroll -->

                        <form asp-controller="Enrollment"
                              asp-action="Enroll"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="courseId"
                                   value="@Model.Id" />

                            <button type="submit"
                                    class="btn btn-primary">

                                Enroll Now

                            </button>

                        </form>
                    }

                </div>
            }


            <!-- ========================= -->
            <!-- Instructor / Admin Actions -->
            <!-- ========================= -->
            @if (Model.CanManage)
            {
                <div class="mt-4">

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-warning">

                        Edit Course

                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-danger">

                        Delete Course

                    </a>

                </div>
            }


            <!-- ========================= -->
            <!-- Back -->
            <!-- ========================= -->

            <div class="mt-4">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    ← Back to Courses

                </a>

            </div>

        </div>

    </div>

</div>