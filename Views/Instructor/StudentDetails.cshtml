@model IEnumerable<CourseHub.Models.Enrollment>

@{
    ViewData["Title"] = "Student Details";

    var student = ViewBag.Student as CourseHub.Models.ApplicationUser;
}

<div class="container py-5">

    <!-- Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1 class="coursehub-admin-title mb-1">
                Student Details
            </h1>

            <p class="text-muted mb-0">
                View this student's enrollments in your courses.
            </p>

        </div>

        <a asp-action="Students"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Students

        </a>

    </div>


    <!-- Student Information -->

    <div class="coursehub-content-card mb-4">

        <div class="card-body p-4">

            <div class="d-flex align-items-center">

                <div class="coursehub-avatar coursehub-avatar-student me-3"
                     style="width:60px;height:60px;">

                    <i class="bi bi-person fs-3"></i>

                </div>

                <div>

                    <h4 class="coursehub-admin-title mb-1">
                        @student?.FullName
                    </h4>

                    <p class="text-muted mb-0">
                        @student?.Email
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- Enrolled Courses -->

    <div class="coursehub-content-card">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>

                    <h4 class="coursehub-admin-title mb-1">
                        Enrolled Courses
                    </h4>

                    <p class="text-muted mb-0">
                        Courses this student enrolled in from you.
                    </p>

                </div>

                <span class="badge bg-primary fs-6">
                    @Model.Count() Courses
                </span>

            </div>


            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>

                            <th>Course</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Enrolled At</th>
                            <th>Action</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var enrollment in Model)
                        {
                            <tr>

                                <td>
                                    <strong>@enrollment.Course.Title</strong>
                                </td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @enrollment.Course.Category.Name
                                    </span>
                                </td>

                                <td>
                                    $@enrollment.Course.Price
                                </td>

                                <td>
                                    @enrollment.EnrolledAt.ToLocalTime().ToString("MMM dd, yyyy")
                                </td>

                                <td>
                                    <a asp-controller="Courses"
                                       asp-action="Details"
                                       asp-route-id="@enrollment.CourseId"
                                       class="btn btn-sm btn-outline-primary">

                                        View Course

                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>