@model IEnumerable<CourseHub.Models.Enrollment>

@{
    ViewData["Title"] = "Enrollments";
}

<div class="container py-5">

    <div class="mb-4">

        <h1 class="coursehub-admin-title">
            Enrollments
        </h1>

        <p class="text-muted">
            All students enrolled in your courses.
        </p>

    </div>

    @if (!Model.Any())
    {
        <div class="coursehub-content-card">

            <div class="card-body text-center p-5">

                <i class="bi bi-person-check fs-1 coursehub-empty-state"></i>

                <h3 class="coursehub-admin-title mt-3">
                    No Enrollments Yet
                </h3>

                <p class="text-muted">
                    No students have enrolled in your courses yet.
                </p>

            </div>

        </div>
    }
    else
    {
        <div class="coursehub-content-card">

            <div class="table-responsive">

                <table class="table table-hover mb-0">

                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Email</th>
                            <th>Course</th>
                            <th>Enrolled At</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var enrollment in Model)
                        {
                            <tr>

                                <td>@enrollment.Student.FullName</td>
                                <td>@enrollment.Student.Email</td>
                                <td>@enrollment.Course.Title</td>
                                <td>@enrollment.EnrolledAt.ToString("MMM dd, yyyy")</td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>