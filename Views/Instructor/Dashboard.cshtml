@model CourseHub.ViewModels.InstructorDashboardViewModel

@{
    ViewData["Title"] = "Instructor Dashboard";
}

<div class="container py-5">

    <div class="mb-4">

        <h1 class="coursehub-admin-title">
            Instructor Dashboard
        </h1>

        <p class="text-muted">
            Manage your courses and track your students.
        </p>

    </div>


    <div class="row g-4">

        <!-- My Courses -->

        <div class="col-md-4">

            <div class="coursehub-stat-card h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-2">
                                My Courses
                            </p>

                            <h2 class="coursehub-admin-title">
                                @Model.MyCoursesCount
                            </h2>

                        </div>

                        <i class="bi bi-book coursehub-stat-icon"></i>

                    </div>

                    <a asp-controller="Instructor"
                       asp-action="MyCourses"
                       class="btn btn-outline-primary mt-3">

                        Manage My Courses

                    </a>

                </div>

            </div>

        </div>


        <!-- Students -->

        <div class="col-md-4">

            <div class="coursehub-stat-card h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-2">
                                Students
                            </p>

                            <h2 class="coursehub-admin-title">
                                @Model.StudentsCount
                            </h2>

                        </div>

                        <i class="bi bi-people coursehub-stat-icon"></i>

                    </div>

                    <a asp-controller="Instructor"
                       asp-action="Students"
                       class="btn btn-outline-success mt-3">

                        View Students

                    </a>

                </div>

            </div>

        </div>


        <!-- Enrollments -->

        <div class="col-md-4">

            <div class="coursehub-stat-card h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-2">
                                Total Enrollments
                            </p>

                            <h2 class="coursehub-admin-title">
                                @Model.TotalEnrollments
                            </h2>

                        </div>

                        <i class="bi bi-person-check coursehub-stat-icon"></i>

                    </div>

                    <a asp-controller="Instructor"
                       asp-action="Enrollments"
                       class="btn btn-outline-warning mt-3">

                        View Enrollments

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>